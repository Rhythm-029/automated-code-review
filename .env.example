# ==============================================================
# Automated Code Review — Environment Configuration
# Copy this file to .env and customize if needed.
# NEVER commit the real .env file with secrets to version control.
# ==============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Review Engine ─────────────────────────────────────────────
# Options: groq | ollama | demo | openai | anthropic | finetuned
# Default: "groq" for high-performance free-tier cloud AI review.
REVIEW_ENGINE=groq

# ── Groq API (Primary Free-Tier Cloud Engine) ─────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=60

# ── Local Ollama (Offline / Local Alternative) ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120

# ── External LLMs (Optional - if REVIEW_ENGINE=openai / anthropic) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Fine-Tuned Local Weights (Optional - if REVIEW_ENGINE=finetuned) ──
FINETUNED_MODEL_PATH=./models/codet5-finetuned

# ── GitHub Integration ────────────────────────────────────────
GITHUB_TOKEN=

# ── Dataset & Storage ─────────────────────────────────────────
DATASET_DIR=./dataset
STORAGE_PATH=./backend/reviews.json

# ── Constraints & Limits ──────────────────────────────────────
MAX_PATCH_CHARS=50000
MAX_COMMENTS=10
