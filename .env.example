# ==============================================================
# Automated Code Review — Environment Configuration
# Copy this file to .env and customize if needed.
# NEVER commit the real .env file with secrets to version control.
# ==============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Review Engine ─────────────────────────────────────────────
# Options: ollama | demo | openai | anthropic | finetuned
# Default is "ollama" for 100% free, local inference with no external API keys.
REVIEW_ENGINE=ollama

# ── Local Ollama (Primary / Recommended) ──────────────────────
# Default local Ollama REST endpoint (http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Local model to use for code review:
OLLAMA_MODEL=qwen2.5-coder:7b
# Request timeout in seconds for local inference:
OLLAMA_TIMEOUT=120

# ── External LLMs (Optional - only if REVIEW_ENGINE=openai / anthropic) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Fine-Tuned Local Weights (Optional - if REVIEW_ENGINE=finetuned) ──
FINETUNED_MODEL_PATH=./models/codet5-finetuned

# ── GitHub Integration (Optional - separate milestone) ────────
GITHUB_TOKEN=

# ── Dataset & Storage ─────────────────────────────────────────
DATASET_DIR=./dataset
STORAGE_PATH=./backend/reviews.json

# ── Constraints & Limits ──────────────────────────────────────
MAX_PATCH_CHARS=50000
MAX_COMMENTS=10
